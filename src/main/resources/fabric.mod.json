{
  "schemaVersion": 1,
  "id": "spoutcraftredux",
  "version": "${version}",
  "name": "SpoutCraft Redux",
  "description": "Lets SpoutCraft Redux servers add GUIs, HUD widgets, sky settings, keybinds and more to your client.",
  "license": "LGPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.spoutcraftredux.client.SpoutCraftReduxClient"
    ]
  },
  "mixins": [
    "spoutcraftredux.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
